# ================= SERVER =================
PORT=5000
NODE_ENV=development
API_VERSION=v1

# ================= DATABASE =================
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/wakriti?retryWrites=true&w=majority

# ================= URLS =================
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ================= JWT =================
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=replace_with_cookie_secret

# ================= ADMIN =================
ADMIN_EMAILS=admin@wakriti.com

# ================= CLOUDINARY =================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ================= RAZORPAY =================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ================= BREVO (EMAIL) =================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@wakriti.com
BREVO_SENDER_NAME=Wa-Kriti

# ================= OTP =================
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ================= RATE LIMITING =================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
